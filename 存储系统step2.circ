  <circuit name="◆熟悉寄存器的使用">
    <a name="circuit" val="◆熟悉寄存器的使用"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="Dialog plain 12"/>
    <a name="clabelcolor" val="#000000"/>
    <wire from="(300,310)" to="(300,340)"/>
    <wire from="(380,340)" to="(420,340)"/>
    <wire from="(300,340)" to="(350,340)"/>
    <wire from="(360,360)" to="(360,400)"/>
    <wire from="(280,350)" to="(350,350)"/>
    <comp lib="6" loc="(344,199)" name="Text">
      <a name="text" val="熟悉寄存器的使用：使能端为1且来一个上升沿，两个条件同时满足寄存器才会被写入"/>
      <a name="font" val="SansSerif bold 12"/>
      <a name="color" val="#000000"/>
      <a name="halign" val="center"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="0" loc="(420,340)" name="Pin">
      <a name="facing" val="west"/>
